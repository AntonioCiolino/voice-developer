# Planner (Plan step) and coder (queued Aider edits) are configured separately.
# PLANNER_PROVIDER: openai (default), ollama, or lmstudio.
PLANNER_PROVIDER=openai
# PLANNER_MODEL overrides the planner model. Default: OPENAI_MODEL, OLLAMA_MODEL or LMSTUDIO_MODEL by provider.
# PLANNER_MODEL=
# CODER_PROVIDER: openai, ollama, or lmstudio. Default: the planner provider.
# CODER_PROVIDER=
# CODER_MODEL overrides the Aider model. Default: OPENAI_MODEL, OLLAMA_MODEL or LMSTUDIO_MODEL by provider.
# CODER_MODEL=
# Shared OpenAI settings. OPENAI_API_KEY is required when either role is openai.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# Optional comma list of OpenAI models offered in the ⚙ models panel (OPENAI_MODEL, PLANNER_MODEL and CODER_MODEL are always offered).
# OPENAI_MODELS=
# Shared local Ollama settings. Loopback only. Used when either role is ollama.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_BASE=http://127.0.0.1:11434
# Shared local LM Studio settings. Loopback only. Used when either role is lmstudio.
# Start the server in LM Studio (Developer tab) and load the model first.
# LMSTUDIO_MODEL is the model identifier LM Studio shows (or `lms ls`), e.g. qwen2.5-coder-7b-instruct.
# LMSTUDIO_MODEL=
# LMSTUDIO_API_BASE=http://127.0.0.1:1234
# Examples (see README "Planner and coder models"):
#  all local:      PLANNER_PROVIDER=ollama PLANNER_MODEL=qwen3:8b CODER_PROVIDER=ollama CODER_MODEL=qwen2.5-coder:7b
#  cloud+local:    PLANNER_PROVIDER=openai PLANNER_MODEL=gpt-5.4-mini CODER_PROVIDER=ollama CODER_MODEL=qwen2.5-coder:7b
#  all cloud:      PLANNER_PROVIDER=openai CODER_PROVIDER=openai CODER_MODEL=<stronger model>
#  cloud+LM Studio: PLANNER_PROVIDER=openai CODER_PROVIDER=lmstudio CODER_MODEL=qwen2.5-coder-7b-instruct
# Coder engine for queued tasks: aider (default) or opencode.
# opencode is a stub: selecting it fails with "not implemented yet" (no fallback to Aider or cloud).
# For Ollama it will need an OpenAI-compatible /v1 provider and a 64k+ context window.
# CODER_ENGINE=aider
# Per-task timeout in seconds for the coder process. Default: 120.
# CODER_TIMEOUT_SECONDS=120
# Aider executable. Default: controller/aider-venv/bin/aider (created by setup.sh,
# kept separate so Aider's dependencies don't change the controller's), else `aider` on PATH.
# AIDER_BIN=
# Aider edit format: diff, diff-fenced, udiff, or whole.
# Default when unset: whole for a local coder (ollama/lmstudio), diff for a cloud coder
# (openai, or an Ollama ':cloud' model). Setting this overrides that for every coder.
# CODER_EDIT_FORMAT=
# Coder escalation: when a task fails on one coder, retry it on the next stronger one. Server-side only.
# CODER_LADDER is provider:model entries, weakest first, comma separated. The coder chosen in the
# models panel (else CODER_PROVIDER/CODER_MODEL) is the starting rung. Unset = a single coder, as before.
# CODER_LADDER=lmstudio:mlx-community/qwen2.5-coder-7b-instruct,openai:gpt-6-luna,openai:gpt-6.1-terra,openai:gpt-6.2-sol,openai:gpt-6.2-astra
# AUTO_ESCALATE: on (default), suggest (stop at the failed task and offer the next rung), or off.
# AUTO_ESCALATE=on
# MAX_PLAN_COST: dollars of coder spend per plan (default 1.00). Checked before each cloud attempt.
# MAX_PLAN_COST=1.00
# ESCALATE_LOCAL_ONLY=on keeps the ladder to local rungs (ollama/lmstudio, not Ollama ':cloud' models).
# ESCALATE_LOCAL_ONLY=off
# Line limit per generated source file. The planner is told to keep every file under it,
# and a file a task changes that ends up longer is reported as a warning on that task.
# MAX_FILE_LINES=150
# Checks run after each task that changed files: a comma list of build (Vite production build to a
# temporary directory) and lint (ESLint undefined-name checks on changed src/ .js/.jsx files), or off.
# A failure gives the coder one retry with the error, then fails and reverts the task. Default: build,lint.
# A check is skipped, with a log line, when node or its node_modules is missing (run ./setup.sh).
# TASK_VALIDATION=build,lint
# Timeout in seconds for each build and each lint run. Default: 120.
# VALIDATION_TIMEOUT_SECONDS=120

# Required. Create a Google OAuth Web application and register the callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=

# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=

# Optional sign-in-free mode for a trusted single-user computer, loopback only by default.
# VOICE_DEVELOPER_LOCAL_AUTH=1
# Explicit opt-in to expose local auth to the trusted LAN at 192.168.5.33.
# Requires VOICE_DEVELOPER_HOST=192.168.5.33 in the start command.
# VOICE_DEVELOPER_LOCAL_AUTH_LAN=1
