# Planner provider: openai (default) or ollama. Ollama must be selected explicitly.
PLANNER_PROVIDER=openai

# OpenAI planner and Aider model. Required when PLANNER_PROVIDER=openai.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Local Ollama planner and Aider model. Used only when PLANNER_PROVIDER=ollama.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_BASE=http://127.0.0.1:11434

# Optional. Used by the direct POST /generate endpoint.
ANTHROPIC_API_KEY=

# Required. Create a Google OAuth Web application and register the callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=

# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=

# Optional sign-in-free mode for a trusted single-user computer, loopback only by default.
# VOICE_DEVELOPER_LOCAL_AUTH=1
# Explicit opt-in to expose local auth to the trusted LAN at 192.168.5.33.
# Requires VOICE_DEVELOPER_HOST=192.168.5.33 in the start command.
# VOICE_DEVELOPER_LOCAL_AUTH_LAN=1
